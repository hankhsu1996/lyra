    name = "address_sanitizer_runtime",
    archive = "@llvm-project//compiler-rt:asan.static",
    cxx_archive = "@llvm-project//compiler-rt:asan_cxx.static",
    root = "address_sanitizer_runtime",
    symbolizer = "@llvm//tools:llvm-symbolizer",
)

