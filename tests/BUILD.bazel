# Two files rather than one selected by name, because a selection by name fails
# open: a filter matching nothing runs no tests and exits zero, so a suite
# renamed on one side and not the other reports a green that measured nothing.
# A file cannot be spelled wrong that way, and which file a case is written in
# is the same decision as when its cost is paid.
#
# Each case runs a few small builds and none shares anything with another, so
# the target takes more shards than it has cases and its wait is its slowest
# case rather than the sum of them; a shard with nothing to run ends at once.
cc_test(
    name = "cli_tests",
    size = "medium",
    srcs = ["cli_test.cpp"],
    copts = LYRA_COPTS,
    data = ["//:lyra"],
    shard_count = 50,
    deps = [
        ":framework",
        "//:driver",
        "@googletest//:gtest_main",
        "@nlohmann_json//:json",
    ],
)

# The command a reader types builds on the default backend, so each example is
# an emitted C++ project built and run by whichever host compiler the executing
# machine has. It is one build per shipped example, seconds each, so it gates.
cc_test(
    name = "examples_tests",
    size = "medium",
    srcs = ["examples_test.cpp"],
    copts = LYRA_COPTS,
    data = [
        "//:examples",
        "//:lyra",
    ],
    deps = [
        ":framework",
        "@googletest//:gtest_main",
    ],
)

# Each design is compiled at one size and at twice that, on both backends, and
# what each run left is held to the design's size, so the cost is two compiles
# per design on each backend and is spread over shards. The execution backend links a program
# with the host C++ compiler, whichever one the executing machine has.
cc_test(
    name = "growth_tests",
    size = "medium",
    srcs = ["growth_test.cpp"],
    copts = LYRA_COPTS,
    data = ["//:lyra"] + glob([
        "growth/*.sv",
        "growth/*.yaml",
        "paths/*.growth.yaml",
    ]),
    shard_count = 8,
    deps = [
        ":framework",
        "//:base",
        "@bazel_tools//tools/cpp/runfiles",
        "@googletest//:gtest_main",
        "@nlohmann_json//:json",
        "@yaml-cpp//:yaml-cpp",
    ],
)

# Each case is built before its edit and after it on both backends. The
# execution backend links a program each time, with the host C++ compiler,
# whichever one the executing machine has, so the cost is two small builds per
# case and is spread over shards.
cc_test(
    name = "incremental_tests",
    size = "medium",
    srcs = ["incremental_test.cpp"],
    copts = LYRA_COPTS,
    data = ["//:lyra"] + glob([
        "incremental/**/*.sv",
        "paths/*.incremental.yaml",
    ]),
    shard_count = 4,
    tags = ["cost"],
    deps = [
        ":framework",
        "@bazel_tools//tools/cpp/runfiles",
        "@googletest//:gtest_main",
        "@nlohmann_json//:json",
        "@yaml-cpp//:yaml-cpp",
    ],
)

# Designs written elsewhere, for other simulators, and kept outside this
# repository: today those of Verilator's benchmark suite, each built and run
# through the case the suite itself marks as its quick check. A design is tens
# of thousands to hundreds of thousands of lines, so one case is minutes and
# gigabytes, and the suite is half a gigabyte to fetch. `manual` is what keeps
# both out of every run that does not name this target: a tag the test filter
# leaves out is still analyzed, and analysis is what fetches. The program is
# linked with the host C++ compiler, and the cases run one at a time because a
# machine holds one such build comfortably and not several. It runs outside the
# sandbox because a case that stops is looked into from the directory it was
# built in, which a sandbox's own temporary directory does not outlive.
cc_test(
    name = "external_design_tests",
    timeout = "eternal",
    srcs = ["external_design_test.cpp"],
    copts = LYRA_COPTS,
    data = [
        "external_design_options.yaml",
        "paths/llvm.external_designs.yaml",
        "//:lyra",
        "@rtlmeter//:suite",
    ],
    tags = [
        "manual",
        "no-remote-exec",
        "no-sandbox",
    ],
    deps = [
        ":framework",
        "@bazel_tools//tools/cpp/runfiles",
        "@googletest//:gtest_main",
    ],
)

