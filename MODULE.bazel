"""
Bazel module file for Lyra SystemVerilog simulator.
"""

module(
    name = "lyra",
    version = "0.1.0",
)

# Bazel rules for C/C++
bazel_dep(name = "rules_cc", version = "0.2.8")

# Slang SystemVerilog Compiler Library
bazel_dep(name = "slang", version = "11.0")
git_override(
    module_name = "slang",
    commit = "88ea59d270d2af90e3a2ded5ff2f64819b93bf04",
    remote = "https://github.com/hankhsu1996/slang.git",
)

# Formatting
bazel_dep(name = "fmt", version = "11.1.3")

# Logging Library
bazel_dep(name = "spdlog", version = "1.15.1")

# Testing framework
bazel_dep(name = "googletest", version = "1.17.0")

# YAML parsing for test data
bazel_dep(name = "yaml-cpp", version = "0.8.0")

# JSON parsing for test results
bazel_dep(name = "nlohmann_json", version = "3.11.3")

# TOML parsing for `lyra.toml`
bazel_dep(name = "tomlplusplus", version = "3.4.0.bcr.1")

# LLVM for code generation, as a library. The module also offers a hermetic
# toolchain, which is not registered: only its `@llvm-project` is used.
bazel_dep(name = "llvm", version = "0.8.23")

llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
use_repo(llvm, "llvm-project")

# The compiler that builds Lyra: this clang release, which the build downloads.
# It is the same on every machine, local or remote, and needs nothing installed.
# `--config=gcc` selects the remote image's GCC instead.
#
# On Linux x86-64 it is fetched as the files its toolchain reads and nothing
# else, cut from the official release by lyra-toolchain's script: every action's
# key hashes the compiler on the machine running Bazel, so a CI runner fetches
# it on every run, and the official archive unpacks to 11 GB. Another host takes
# the official archive.
#
# The C++ standard library is the machine's own libstdc++, not the one the
# release ships. A program Lyra builds is linked by the user's compiler against
# the runtime library built here, and the two have to use the same library.
bazel_dep(name = "toolchains_llvm", version = "1.11.3")

clang = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
clang.toolchain(
    name = "clang_toolchain",
    llvm_version = "20.1.8",
    sha256 = {"linux-x86_64": "a110f87318ea5f9dd677c016dc68792716cb4383539282960c3f355ade1b002a"},
    stdlib = {"": "dynamic-stdc++"},
    strip_prefix = {"linux-x86_64": "clang-20.1.8-linux-x64"},
    urls = {"linux-x86_64": [
        "https://github.com/hankhsu1996/lyra-toolchain/releases/download/clang-20.1.8/clang-20.1.8-linux-x64.tar.zst",
    ]},
)
use_repo(clang, "clang_toolchain")

register_toolchains("@clang_toolchain//:all")

# Stackful fibers for suspending foreign (DPI) calls across simulation time
bazel_dep(name = "boost.context", version = "1.89.0")

# The machine remote actions run on, BuildBuddy's Ubuntu 24.04 image, and its
# GCC 13, which `--config=gcc` selects.
bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4")

buildbuddy = use_extension("@toolchains_buildbuddy//:extensions.bzl", "buildbuddy")
buildbuddy.platform(buildbuddy_container_image = "UBUNTU24_04_IMAGE")
use_repo(buildbuddy, "buildbuddy_toolchain")

register_toolchains("@buildbuddy_toolchain//:all")

# The designs Verilator's benchmark suite builds and runs, each with the tests
# and the checks its authors gave it. Nothing here is Lyra's: the suite is read
# at one commit, so that a design that stops doing what it did is a change of
# Lyra's and not of the suite's, and what is applied on top is only what has
# been sent to the suite itself. It is fetched only when a target that reads it
# is built, and those are named outright and never part of `//...`.
git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

git_repository(
    name = "rtlmeter",
    build_file_content = """
filegroup(
    name = "suite",
    srcs = glob([
        "designs/**",
        "rtl/**",
    ]),
    visibility = ["//visibility:public"],
)
""",
    commit = "f63e557d638d7305b44bc1d6c58170bd2cdec3c8",
    remote = "https://github.com/verilator/rtlmeter.git",
)

# Development tools
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "1e08f8e0507b6b6b1f4416a9a22cf5c28beaba93",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
)
