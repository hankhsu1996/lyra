        ":support",
        ":value",
        "@boost.context//:boost.context",
    ],
)

cc_static_library(
    name = "cpp_runtime_lib",
    visibility = ["//visibility:public"],
    deps = [":runtime"],
)

# What an emitted program links. Optimized whatever mode built the compiler:
# a user's simulation runs this code, and none of it is recompiled on their
# side, so its speed is fixed here and nowhere else.
shipped_artifact(
    name = "cpp_runtime",
    out = "libcpp_runtime.a",
    lib = ":cpp_runtime_lib",
    visibility = ["//visibility:public"],
)

