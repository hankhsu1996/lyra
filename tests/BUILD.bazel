load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//tools/bazel:copts.bzl", "LYRA_COPTS")

# The test framework's own headers answer to the same self-containment rule as
# the headers under test.
package(features = ["parse_headers"])

# `benchmark/` holds a corpus and deliberately no target. It answers how fast
# rather than whether, and a duration needs a machine that is running nothing
# else, where a build system runs its tests in parallel and returns a cached
# result from whatever machine state produced it. It is driven by
# `tools/bench/run_benchmarks.py` instead.

# Two facts about a test are marked here, and they are independent.
#
# `no-remote-exec` says where it can run. A test that shells out to the host C++
# compiler spawns something that is not a Bazel action, so it runs on whatever
# machine executes it and finds that machine's compiler on PATH. The remote
# image has the platform's own C++ compiler and no clang, so a test runs
# remotely unless what it asserts is about clang itself -- a precompiled header
# is clang's alone -- and the tag holds that one on a machine that has clang.
#
# `nightly` says when its cost is paid, and what it draws is one subject rather
# than one price: whether an emitted C++ project still builds and runs. Two
# targets carry it -- the whole corpus through that path, and the cases that
# assert what a project does once built. Both spend most of their time in the
# host compiler with no prepared header to lean on: an emitted project carries
# its own copy of the runtime headers, which a prepared header cannot be shared
# across because it is bound to the paths it was made from, and the corpus runs
# where the compiler is not clang, which is the only one that reads one. Both
# are therefore excluded for their own reason and not for a neighbour's, which
# is the test a removal here has to pass.
#
# Everything about the command line itself gates, and costs seconds, because
# what a design declares and how a failure is reported are not statements about
# a backend and need no compiler to answer.
#
# The two sides of `nightly` are complements, so every target is covered once
# and none twice, and a new one joins whichever side its tag puts it on.

cc_library(
    name = "framework",
    srcs = glob(["framework/*.cpp"]),
    hdrs = glob(["framework/*.hpp"]),
    copts = LYRA_COPTS,
    visibility = ["//tests:__subpackages__"],
    deps = [
        "//:base",
        "//:support",
        "@bazel_tools//tools/cpp/runfiles",
        "@fmt",
        "@googletest//:gtest",
        "@yaml-cpp//:yaml-cpp",
    ],
)

cc_test(
    name = "base_fixed_array_test",
    srcs = ["base/fixed_array_test.cpp"],
    copts = LYRA_COPTS,
    deps = [
        "//:base",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "value_packed_array_test",
    srcs = ["value/packed_array_test.cpp"],
    copts = LYRA_COPTS,
    deps = [
        "//:value",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "mir_integral_constant_test",
    srcs = ["mir/integral_constant_test.cpp"],
    copts = LYRA_COPTS,
    deps = [
        "//:mir",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "diag_render_tests",
    srcs = ["diag/render_test.cpp"],
    copts = LYRA_COPTS,
    deps = [
        "//:base",
        "//:diag",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "artifact_count_test",
    srcs = ["artifact_count_test.cpp"],
    copts = LYRA_COPTS,
    deps = [
        "//:compiler",
        "//:diag",
        "//:hir",
        "@googletest//:gtest_main",
        "@slang",
    ],
)

cc_test(
    name = "runtime_object_ref_test",
    srcs = ["runtime/object_ref_test.cpp"],
    copts = LYRA_COPTS,
    deps = [
        "//:runtime",
        "@googletest//:gtest_main",
    ],
)

# Two files rather than one selected by name, because a selection by name fails
# open: a filter matching nothing runs no tests and exits zero, so a suite
# renamed on one side and not the other reports a green that measured nothing.
# A file cannot be spelled wrong that way, and which file a case is written in
# is the same decision as when its cost is paid.
cc_test(
    name = "cli_tests",
    size = "medium",
    srcs = ["cli_test.cpp"],
    copts = LYRA_COPTS,
    data = ["//:lyra"],
    deps = [
        ":framework",
        "//:support",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "emitted_project_tests",
    # Each case builds an emitted project with the host compiler, several of
    # them more than once, and no two can share the header one prepared.
    # Declaring that cost is what keeps a loaded machine from reporting a
    # timeout as a test failure. Several of them are about the prepared header,
    # which only clang makes, so they stay where clang is.
    size = "large",
    srcs = ["emitted_project_test.cpp"],
    copts = LYRA_COPTS,
    data = ["//:lyra"],
    shard_count = 4,
    tags = [
        "nightly",
        "no-remote-exec",
    ],
    deps = [
        ":framework",
        "//:support",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "pch_audit_test",
    srcs = ["pch_audit_test.cpp"],
    copts = LYRA_COPTS,
    data = ["//:lyra"],
    # Spawns the host C++ compiler with `-H` to enumerate every header opened
    # while building the prelude PCH.
    tags = ["no-remote-exec"],
    deps = [
        ":framework",
        "//:driver",
        "//:support",
        "@fmt",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "runtime_surface_test",
    srcs = ["runtime_surface_test.cpp"],
    copts = LYRA_COPTS,
    data = ["//:lyra"],
    # Emits a design, compiles its units against the shipped headers and reads
    # what each object defines, which needs the host C++ compiler.
    tags = ["no-remote-exec"],
    deps = [
        ":framework",
        "//:driver",
        "//:support",
        "@googletest//:gtest_main",
    ],
)

# The conformance corpus, run once per path. A path is the artifact a run
# produces, so the two here are the C++ project and the LLVM module; how that
# module is then executed does not change which programs it accepts. Each target
# reads the same corpus and the record of what its own path currently refuses.
CONFORMANCE_DATA = [
    "//:lyra",
] + glob(
    [
        "conformance/**/*.sv",
        "conformance/**/*.sv.deferred",
        "conformance/**/*.c",
        "conformance/**/*.cpp",
        "paths/*.yaml",
    ],
    allow_empty = True,
)

cc_test(
    name = "cpp_tests",
    # Each case builds emitted C++ with the host compiler, so a shard's cost is
    # dominated by compilation rather than by simulation. Declaring that cost is
    # what keeps a loaded machine from reporting a timeout as a test failure.
    # Remotely the compiler has no prepared header, so the corpus is cut into
    # enough shards that the slowest stays well inside that declared cost.
    size = "large",
    srcs = ["conformance_test.cpp"],
    args = [
        "--path",
        "cpp",
    ],
    copts = LYRA_COPTS,
    data = CONFORMANCE_DATA,
    shard_count = 48,
    tags = ["nightly"],
    deps = [
        ":framework",
        "@bazel_tools//tools/cpp/runfiles",
        "@fmt",
        "@googletest//:gtest",
    ],
)

# Each case links a program with the host C++ compiler, and a case carrying
# foreign sources compiles them with it too. A shard runs remotely, where
# another one costs a slot in the remote queue rather than a core here, so the
# corpus is cut finely enough that the slowest shard is what a wait is made of.
cc_test(
    name = "llvm_tests",
    srcs = ["conformance_test.cpp"],
    args = [
        "--path",
        "llvm",
    ],
    copts = LYRA_COPTS,
    data = CONFORMANCE_DATA,
    shard_count = 48,
    deps = [
        ":framework",
        "@bazel_tools//tools/cpp/runfiles",
        "@fmt",
        "@googletest//:gtest",
    ],
)

# The corpus read as a set of designs rather than as a set of claims about
# IEEE 1800: every one of them compiled twice, to hold the compiler to answering
# the same way both times. It reads the emitted text in process and starts no
# host tool, so it runs wherever the cheap targets run.
cc_test(
    name = "repeatable_emission_test",
    srcs = ["repeatable_emission_test.cpp"],
    copts = LYRA_COPTS,
    data = CONFORMANCE_DATA,
    shard_count = 8,
    deps = [
        ":framework",
        "//:compiler",
        "//:diag",
        "//:driver",
        "@bazel_tools//tools/cpp/runfiles",
        "@fmt",
        "@googletest//:gtest",
        "@slang",
    ],
)
