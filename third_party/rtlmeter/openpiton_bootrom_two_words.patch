The OpenPiton boot ROM holds one word, so RomSize is 1, $clog2(RomSize) is 0,
and the address select becomes addr_i[2:3] on a [63:0] vector, whose bounds run
against the declaration (IEEE 1800-2023 11.5.1). Regenerate it with two words:
the result is what Ariane's gen_rom.py writes for the same code padded to 16
bytes, and the second word is never fetched.

Reported as https://github.com/verilator/rtlmeter/issues/56

diff --git a/designs/OpenPiton/src/common/bootrom.sv b/designs/OpenPiton/src/common/bootrom.sv
index 5cfe2a8..57db3f8 100644
--- a/designs/OpenPiton/src/common/bootrom.sv
+++ b/designs/OpenPiton/src/common/bootrom.sv
@@ -20,9 +20,10 @@ module bootrom (
    input  logic [63:0]  addr_i,
    output logic [63:0]  rdata_o
 );
-    localparam int RomSize = 1;
+    localparam int RomSize = 2;
 
     const logic [RomSize-1:0][63:0] mem = {
+        64'h00000000_00000000,
         64'h00008502_057e4505
     };
 
