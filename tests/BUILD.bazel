cc_test(
    name = "emitted_project_tests",
    # Each case builds an emitted project with the host compiler, several of
    # them more than once, and no two can share the header one prepared.
    # Declaring that cost is what keeps a loaded machine from reporting a
    # timeout as a test failure. The costliest cases each compile the whole
    # runtime for link-time optimization, so the target takes as many shards as
    # Bazel allows, which keeps them apart without this count having to follow
    # how many cases there are; a shard with nothing to run ends at once.
    size = "large",
    srcs = ["emitted_project_test.cpp"],
    copts = LYRA_COPTS,
    data = ["//:lyra"],
    shard_count = 50,
    # The cases asking what each compiler makes of an optimized link compile
    # the runtime beside the design, under the clang and the GCC a machine has
    # installed, so they run where both are.
    tags = [
        "nightly",
        "no-remote-exec",
    ],
    deps = [
        ":framework",
        "//:driver",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "prepared_header_test",
    srcs = ["prepared_header_test.cpp"],
    copts = LYRA_COPTS,
    # Each case runs under clang and under GCC, since what a compiler checks of
    # a prepared header and which flags it takes are its own: the clang of the
    # release Lyra links, which it is handed, and the executing machine's GCC.
    data = [
        "//:lyra",
        "@llvm//:builtin_resource_dir",
        "@llvm//tools:clang++",
    ],
    env = {"CLANGXX": "$(rlocationpath @llvm//tools:clang++)"},
    deps = [
        ":framework",
        "//:driver",
        "//:support",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "runtime_surface_test",
    srcs = ["runtime_surface_test.cpp"],
    copts = LYRA_COPTS,
    # Emits a design, compiles its units against the shipped headers with the
    # clang of the release Lyra links and with the executing machine's GCC, and
    # reads what each object defines and asks for, and what each of its
    # sections refers to, with that release's symbol lister and object dumper.
    data = [
        "//:lyra",
        "@llvm//:builtin_resource_dir",
        "@llvm//tools:clang++",
        "@llvm//tools:llvm-nm",
        "@llvm//tools:llvm-objdump",
    ],
    env = {
        "CLANGXX": "$(rlocationpath @llvm//tools:clang++)",
        "LLVM_NM": "$(rlocationpath @llvm//tools:llvm-nm)",
        "LLVM_OBJDUMP": "$(rlocationpath @llvm//tools:llvm-objdump)",
    },
    deps = [
        ":framework",
        "//:driver",
        "@googletest//:gtest_main",
    ],
)

# The conformance corpus, run once per path. A path is the artifact a run
# produces, so the two here are the C++ project and the LLVM module; how that
# module is then executed does not change which programs it accepts. Each target
# reads the same corpus and the record of what its own path currently refuses.
CONFORMANCE_DATA = [
    "//:lyra",
] + glob(
    [
        "choices/**/*.c",
        "choices/**/*.cpp",
        "choices/**/*.sv",
        "choices/**/expected/*",
        "choices/**/lib.map",
        "paths/*.yaml",
    ],
    allow_empty = True,
) + [
    "//conformance:corpus",
    "//conformance:selftest",
]

cc_test(
    name = "cpp_tests",
    # Each case builds emitted C++ with the host compiler, so a shard's cost is
    # dominated by compilation rather than by simulation. Declaring that cost is
    # what keeps a loaded machine from reporting a timeout as a test failure.
    # A case compiles its units one after another, so a shard runs several
    # cases at once, and the slowest case bounds its shard whatever the count.
    size = "large",
    srcs = ["conformance_test.cpp"],
    args = [
        "--path",
        "cpp",
        "--workers",
        str(_HOST_COMPILES_AT_ONCE),
    ],
    copts = LYRA_COPTS,
    data = CONFORMANCE_DATA,
    shard_count = 48,
    tags = [
        "cpu:%d" % _HOST_COMPILES_AT_ONCE,
        "nightly",
    ],
    deps = [
        ":framework",
        "@bazel_tools//tools/cpp/runfiles",
        "@fmt",
        "@googletest//:gtest",
    ],
)

# Each case links a program with the host C++ compiler, and a case carrying
# foreign sources compiles them with it too, so a shard runs several cases at
# once. A shard runs remotely, where another one costs a slot in the remote
# queue rather than a core here, so the corpus is cut finely enough that the
# slowest shard is what a wait is made of.
cc_test(
    name = "llvm_tests",
    srcs = ["conformance_test.cpp"],
    # Where the build checks Lyra's own memory, every program the corpus builds
    # is checked as well, so one scheduled run answers whether anything reads
    # storage that has ended, in the compiler or in what it built.
    args = [
        "--path",
        "llvm",
        "--workers",
        str(_HOST_COMPILES_AT_ONCE),
    ] + select({
        "//tools/bazel:under_address_sanitizer": [
            "--sanitize",
            "address",
        ],
        "//conditions:default": [],
    }),
    copts = LYRA_COPTS,
    data = CONFORMANCE_DATA,
    shard_count = 48,
    tags = ["cpu:%d" % _HOST_COMPILES_AT_ONCE],
    deps = [
        ":framework",
        "@bazel_tools//tools/cpp/runfiles",
        "@fmt",
        "@googletest//:gtest",
    ],
)

# The corpus read as a set of designs rather than as a set of claims about
# IEEE 1800: every one of them compiled twice, to hold the compiler to answering
# the same way both times, and the text it wrote to nesting no deeper than a C++
# compiler has to accept. It reads the emitted text in process and starts no
# host tool, so it runs wherever the cheap targets run.
cc_test(
    name = "repeatable_emission_test",
    srcs = [
        "compiled_twice.hpp",
        "repeatable_emission_test.cpp",
    ],
    copts = LYRA_COPTS,
    data = CONFORMANCE_DATA,
    shard_count = 8,
    deps = [
        ":framework",
        "//:compiler",
        "//:diag",
        "//:driver",
        "//:mir_transform",
        "@bazel_tools//tools/cpp/runfiles",
        "@fmt",
        "@googletest//:gtest",
        "@slang",
    ],
)

# Whether a case leans on the order static initializers run in, which the
