load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//tools/bazel:copts.bzl", "LYRA_COPTS")

# The test framework's own headers answer to the same self-containment rule as
# the headers under test.
package(features = ["parse_headers"])

cc_library(
    name = "framework",
    srcs = glob(["framework/*.cpp"]),
    hdrs = glob(["framework/*.hpp"]),
    copts = LYRA_COPTS,
    visibility = ["//tests:__subpackages__"],
    deps = [
        "//:value",
        "@fmt",
        "@yaml-cpp//:yaml-cpp",
    ],
)

cc_test(
    name = "diag_render_tests",
    srcs = ["diag/render_test.cpp"],
    copts = LYRA_COPTS,
    deps = [
        "//:diag",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "runtime_gc_ref_test",
    srcs = ["runtime/gc_ref_test.cpp"],
    copts = LYRA_COPTS,
    deps = [
        "//:runtime",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "run_tests",
    # Every case builds emitted C++ with the host compiler, which costs far more
    # than running the simulation does. Declaring that cost is what keeps a
    # loaded machine from reporting a timeout as a test failure.
    size = "large",
    srcs = ["run_test.cpp"],
    copts = LYRA_COPTS,
    data = ["//:lyra"],
    # `compile`/`run` drive the host C++ compiler, so this is excluded from CI's
    # `Test` job (which filters out `requires-host-cxx`). Run locally with
    # `bazel test //tests:run_tests`.
    tags = ["requires-host-cxx"],
    deps = [
        ":framework",
        "//:support",
        "@bazel_tools//tools/cpp/runfiles",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "pch_audit_test",
    srcs = ["pch_audit_test.cpp"],
    copts = LYRA_COPTS,
    data = ["//:lyra"],
    # Spawns the host C++ compiler with `-H` to enumerate every header opened
    # while building the prelude PCH. Filtered out of CI's `Test` job for the
    # same reason as run_tests/cpp_tests; run locally as needed.
    tags = ["requires-host-cxx"],
    deps = [
        "//:driver",
        "//:support",
        "@bazel_tools//tools/cpp/runfiles",
        "@fmt",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "cpp_tests",
    # Each case builds emitted C++ with the host compiler, so a shard's cost is
    # dominated by compilation rather than by simulation. Declaring that cost is
    # what keeps a loaded machine from reporting a timeout as a test failure.
    size = "large",
    srcs = ["cpp_test.cpp"],
    copts = LYRA_COPTS,
    data = [
        "suites.yaml",
        "//:lyra",
    ] + glob(
        [
            "cases/**/*.yaml",
            "cases/**/*.sv",
            "cases/**/*.c",
            "cases/**/*.cpp",
        ],
        allow_empty = True,
    ),
    shard_count = 16,
    # cpp-backend cases run `lyra run`, which builds with the host C++ compiler.
    # CI's `Test` job passes `--test_tag_filters=-requires-host-cxx` so this
    # target is excluded; run locally with `bazel test //tests:cpp_tests`.
    tags = ["requires-host-cxx"],
    deps = [
        ":framework",
        "@bazel_tools//tools/cpp/runfiles",
        "@fmt",
        "@googletest//:gtest",
    ],
)

cc_test(
    name = "jit_tests",
    srcs = ["cpp_test.cpp"],
    args = [
        "--suite",
        "jit",
    ],
    copts = LYRA_COPTS,
    data = [
        "suites.yaml",
        "//:lyra",
    ] + glob(
        [
            "cases/**/*.yaml",
            "cases/**/*.sv",
            "cases/**/*.c",
            "cases/**/*.cpp",
        ],
        allow_empty = True,
    ),
    shard_count = 8,
    # The execution backend compiles nothing through the host C++ compiler, so
    # unlike cpp_tests this target carries no `requires-host-cxx` tag and CI's
    # `Test` job runs it.
    deps = [
        ":framework",
        "@bazel_tools//tools/cpp/runfiles",
        "@fmt",
        "@googletest//:gtest",
    ],
)
