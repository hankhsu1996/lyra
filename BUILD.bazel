load("@hedron_compile_commands//:refresh_compile_commands.bzl", "refresh_compile_commands")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_static_library.bzl", "cc_static_library")
load("//tools/bazel:copts.bzl", "LYRA_COPTS")
load("//tools/bazel:shipped.bzl", "shipped_artifact")

# Compile every declared header once on its own, so a header that only builds
# because some source happened to include its dependency first fails here
# rather than silently in an editor. Scoped to this package for the same reason
# the warning flags are: a dependency's headers answer to its own policy.
package(features = ["parse_headers"])

filegroup(
    name = "runtime_headers",
    srcs = glob([
        "include/lyra/runtime/*.hpp",
        "include/lyra/value/*.hpp",
        "include/lyra/support/*.hpp",
        "include/lyra/base/*.hpp",
    ]),
    visibility = ["//visibility:public"],
)

refresh_compile_commands(
    name = "refresh_compile_commands",
    exclude_external_sources = True,
    exclude_headers = "external",
    targets = {
        # Bazel's header-parsing actions compile a header with no source file
        # in the command, which the refresher cannot read; turning the feature
        # off for this run leaves the ordinary compile actions it does read.
        "//...": "--features=-parse_headers",
    },
)

cc_library(
    name = "base",
    srcs = glob(["src/lyra/base/*.cpp"]),
    hdrs = glob(["include/lyra/base/*.hpp"]),
    copts = LYRA_COPTS,
    includes = ["include"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "support",
    srcs = glob(["src/lyra/support/*.cpp"]),
    hdrs = glob(["include/lyra/support/*.hpp"]),
    copts = LYRA_COPTS,
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":base",
        ":diag",
    ],
)

cc_library(
    name = "diag",
    srcs = glob(["src/lyra/diag/*.cpp"]),
    hdrs = glob(["include/lyra/diag/*.hpp"]),
    copts = LYRA_COPTS,
