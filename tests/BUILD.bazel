# Which of a program's requests an address limit refuses is set by what the
# runtime asks for and when, and a build under the sanitizer maps address space
# of its own that no limit this small leaves room for. The program is linked
# with the host C++ compiler, whichever one the executing machine has.
cc_test(
    name = "out_of_memory_tests",
    size = "medium",
    srcs = ["out_of_memory_test.cpp"],
    copts = LYRA_COPTS,
    data = ["//:lyra"],
    tags = ["cost"],
    deps = [
        ":framework",
        "//:driver",
        "@googletest//:gtest_main",
    ],
)

