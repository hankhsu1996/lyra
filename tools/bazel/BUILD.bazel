# Everything the build compiles is compiled for the oldest C library Lyra
# supports and the oldest release of the C++ library a design may be compiled
# with. An artifact needs of a machine exactly what it was compiled and linked
# against, and headers of a later release may name what the oldest lacks, so
# compiling against the oldest release promised is what lets the result run on
# every later one.
platform(
    name = "oldest_supported_linux",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@llvm//constraints/libc:gnu.2.34",
        "@llvm//constraints/cxxstdlib:libstdcxx.13.2.0",
    ],
    visibility = ["//visibility:public"],
)

# Whether the build is under the address sanitizer, read off the compile option
# every compiler is given for it, so nothing else has to be kept saying so.
config_setting(
    name = "under_address_sanitizer",
    values = {"copt": "-fsanitize=address"},
    visibility = ["//visibility:public"],
)

# The same build where clang is the compiler. Lyra is built by GCC and by clang,
# and the pinned clang's toolchain is the one of the two that names its
# compiler, since the remote image's GCC states no name a setting could match.
config_setting(
    name = "clang_under_address_sanitizer",
    flag_values = {"@bazel_tools//tools/cpp:compiler": "clang"},
    values = {"copt": "-fsanitize=address"},
    visibility = ["//visibility:public"],
)
