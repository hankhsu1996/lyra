load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//tools/bazel:copts.bzl", "LYRA_COPTS")

# The test framework's own headers answer to the same self-containment rule as
# the headers under test.
package(features = ["parse_headers"])

# `requires-host-cxx` marks a test that shells out to the host C++ compiler to
# build emitted code. That compiler is not a Bazel action, so remote execution
# cannot provision it, and `no-remote-exec` holds such a test on a machine that
# has one. The tag also selects the whole group in or out of a run, which is how
# a cost dominated by compilation is kept off a merge-time budget.

cc_library(
    name = "framework",
    srcs = glob(["framework/*.cpp"]),
    hdrs = glob(["framework/*.hpp"]),
    copts = LYRA_COPTS,
    visibility = ["//tests:__subpackages__"],
    deps = [
        "//:value",
        "@fmt",
        "@yaml-cpp//:yaml-cpp",
    ],
)

cc_test(
    name = "diag_render_tests",
    srcs = ["diag/render_test.cpp"],
    copts = LYRA_COPTS,
    deps = [
        "//:base",
        "//:diag",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "runtime_gc_ref_test",
    srcs = ["runtime/gc_ref_test.cpp"],
    copts = LYRA_COPTS,
    deps = [
        "//:runtime",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "cli_tests",
    # Every case builds emitted C++ with the host compiler, which costs far more
    # than running the simulation does. Declaring that cost is what keeps a
    # loaded machine from reporting a timeout as a test failure.
    size = "large",
    srcs = ["cli_test.cpp"],
    copts = LYRA_COPTS,
    data = ["//:lyra"],
    shard_count = 4,
    tags = [
        "no-remote-exec",
        "requires-host-cxx",
    ],
    deps = [
        ":framework",
        "//:support",
        "@bazel_tools//tools/cpp/runfiles",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "pch_audit_test",
    srcs = ["pch_audit_test.cpp"],
    copts = LYRA_COPTS,
    data = ["//:lyra"],
    # Spawns the host C++ compiler with `-H` to enumerate every header opened
    # while building the prelude PCH.
    tags = [
        "no-remote-exec",
        "requires-host-cxx",
    ],
    deps = [
        "//:driver",
        "//:support",
        "@bazel_tools//tools/cpp/runfiles",
        "@fmt",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "cpp_tests",
    # Each case builds emitted C++ with the host compiler, so a shard's cost is
    # dominated by compilation rather than by simulation. Declaring that cost is
    # what keeps a loaded machine from reporting a timeout as a test failure.
    size = "large",
    srcs = ["corpus_test.cpp"],
    args = [
        "--suite",
        "cpp",
    ],
    copts = LYRA_COPTS,
    data = [
        "suites.yaml",
        "//:lyra",
    ] + glob(
        [
            "cases/**/*.yaml",
            "cases/**/*.sv",
            "cases/**/*.c",
            "cases/**/*.cpp",
        ],
        allow_empty = True,
    ),
    shard_count = 16,
    tags = [
        "no-remote-exec",
        "requires-host-cxx",
    ],
    deps = [
        ":framework",
        "@bazel_tools//tools/cpp/runfiles",
        "@fmt",
        "@googletest//:gtest",
    ],
)

cc_test(
    name = "jit_tests",
    srcs = ["corpus_test.cpp"],
    args = [
        "--suite",
        "jit",
    ],
    copts = LYRA_COPTS,
    data = [
        "suites.yaml",
        "//:lyra",
    ] + glob(
        [
            "cases/**/*.yaml",
            "cases/**/*.sv",
            "cases/**/*.c",
            "cases/**/*.cpp",
        ],
        allow_empty = True,
    ),
    shard_count = 8,
    deps = [
        ":framework",
        "@bazel_tools//tools/cpp/runfiles",
        "@fmt",
        "@googletest//:gtest",
    ],
)
