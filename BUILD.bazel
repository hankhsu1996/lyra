# Compile every declared header once on its own, so a header that only builds
# because some source happened to include its dependency first fails here
# rather than silently in an editor. Scoped to this package for the same reason
# the warning flags are: a dependency's headers answer to its own policy.
package(features = ["parse_headers"])

filegroup(
    name = "runtime_headers",
    srcs = glob([
        "include/lyra/abi/*.hpp",
        "include/lyra/runtime/*.hpp",
        "include/lyra/value/*.hpp",
        "include/lyra/support/*.hpp",
        "include/lyra/base/*.hpp",
    ]),
    visibility = ["//visibility:public"],
)

# Everything a reader is handed to run, each directory as it is shipped.
filegroup(
    name = "examples",
    srcs = glob(["examples/**"]),
    visibility = ["//tests:__pkg__"],
)

# The surface an emitted project compiles against, under a root of its own. The
# compiler copies what it finds around one of these headers, so what shares that
# root is what a user's project receives -- and beside the sources it would be
# every header this repository has, including the layers and the backends.
shipped_headers(
    name = "runtime_surface",
    hdrs = [":runtime_headers"],
    root = "runtime_surface",
    strip_prefix = "include",
    visibility = ["//visibility:public"],
)

refresh_compile_commands(
    name = "refresh_compile_commands",
    exclude_external_sources = True,
    exclude_headers = "external",
    targets = {
        # Bazel's header-parsing actions compile a header with no source file
        # in the command, which the refresher cannot read; turning the feature
        # off for this run leaves the ordinary compile actions it does read.
        "//...": "--features=-parse_headers",
        # Tagged manual, so `//...` leaves them out, and an editor would have
        # no command to analyze their sources by. Naming them fetches the
        # suite they read.
        "//tests:declare_external_design": "--features=-parse_headers",
        "//tests:external_design_tests": "--features=-parse_headers",
    },
)

