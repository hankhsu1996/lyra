# The command surface: what commands exist, how a command line and a design's
# declaration are read, and what each command does. It sits above `driver`,
# which supplies the build, cache and foreign-boundary machinery it orchestrates.
cc_library(
    name = "cli",
    srcs = glob(
        ["src/lyra/cli/*.cpp"],
        exclude = ["src/lyra/cli/main.cpp"],
    ),
    hdrs = glob(["include/lyra/cli/*.hpp"]),
    copts = LYRA_COPTS,
    includes = ["include"],
    # A malformed `lyra.toml` is a recoverable failure the caller
    # reports, so the TOML parser has to hand its error back rather than throw
    # one; the library reads this at include time and cannot be told later.
    local_defines = ["TOML_EXCEPTIONS=0"],
    visibility = ["//visibility:public"],
    deps = [
        ":backend_llvm",
        ":compiler",
        ":diag",
        ":driver",
        ":hir",
        ":lir",
        ":mir",
        ":mir_transform",
        ":profiling",
        ":program",
        ":status",
        ":support",
        "@fmt",
        "@slang",
        "@tomlplusplus",
    ],
)

