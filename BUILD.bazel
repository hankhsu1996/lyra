    lib = ":runtime",
    root = "runtime_sources",
    visibility = ["//visibility:public"],
)

# What an emitted program links. Optimized whatever mode built the compiler,
# because a user's simulation runs this code as it is shipped.
shipped_artifact(
    name = "cpp_runtime",
    out = "libcpp_runtime.a",
    lib = ":cpp_runtime_lib",
    visibility = ["//visibility:public"],
)

# The same library compiled to check the memory of a program the execution
# backend builds with `--sanitize address`, and the sanitizer's own runtime of
# the release that compiled it, which such a program links. The C++ backend
# compiles the runtime's sources with its own compiler instead, whose sanitizer
# goes with it.
shipped_artifact(
    name = "cpp_runtime_address_sanitized",
    out = "libcpp_runtime_address_sanitized.a",
    lib = ":cpp_runtime_lib",
    sanitizer = "address",
    visibility = ["//visibility:public"],
)

